  m_EditorClassIdentifier: Assembly-CSharp::StoryManager
  storyText: {fileID: 2032733563}
  screenButton: {fileID: 544104730}
  bgImage: {fileID: 1260497938}
  globalVideoDisplay: {fileID: 1097931887}
  miniGameRoot: {fileID: 900098589}
  fillImage: {fileID: 1397913189}
  targetChangeImage: {fileID: 1680165208}
  hiddenObj: {fileID: 391622848}
  targetColor: {r: 0.47843137, g: 0.9647059, b: 0.9882353, a: 1}
  storyData:
  - text: "\uC2DC\uC2A4\uD15C \uC900\uBE44\uC911..."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uB9AC\uBD80\uD305 \uB300\uAE30, \uC804\uB825\uB7C9 \uD655\uC778\uC911.."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uC804\uB825 \uBD80\uC871, \uD654\uBA74\uC744 \uD074\uB9AD\uD574 \uC8FC\uC138\uC694"
    triggerMiniGame: 1
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uCDA9\uC804 \uC644\uB8CC, \uBD80\uD305 \uC2DC\uC791"
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uC548\uB155\uD558\uC138\uC694! \uC774 \uAC8C\uC784\uC744 \uC2DC\uC791\uD574\uC8FC\uC154\uC11C
      \uAC10\uC0AC\uD574\uC694!"
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uB208\uC55E\uC5D0 \uBCF4\uC774\uB294 \uC774 \uC0DD\uBA85\uCCB4\uB294
      \uC6CC\uB4DC \uC774\uD130\uB77C\uACE0 \uD569\uB2C8\uB2E4."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 0
    videoPlayer: {fileID: 0}
  - text: "\uC774 \uD2B9\uC218 \uC81C\uC791\uB41C \uC2A4\uB9C8\uD2B8\uD3F0 \uC18D\uC5D0\uC11C
      \uC0B4\uC544\uAC00\uACE0 \uC788\uC8E0."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uC6CC\uB4DC \uC774\uD130\uB294 \uC5EC\uB7EC \uBAA8\uC2B5\uC744 \uAC00\uC9C0\uACE0
      \uB2F9\uC2E0 \uC55E\uC5D0 \uB098\uD0C0\uB0A0 \uAC70\uC5D0\uC694."
    triggerMiniGame: 0
    effectType: 1
    effectImages:
    - {fileID: 121830512}
    - {fileID: 169801691}
    - {fileID: 1148657552}
    - {fileID: 1699059616}
    effectTargets:
    - {fileID: 34443681}
    - {fileID: 1163542278}
    - {fileID: 1550103861}
    - {fileID: 1090889330}
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uD558\uC9C0\uB9CC \uC9C0\uAE08\uC740 \uC544\uC9C1 \uBBF8\uC131\uC219\uD558\uACE0
      \uBD88\uC548\uC815\uD55C \uC0C1\uD0DC\uC5D0\uC694."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uC5EC\uB7EC\uBD84\uC758 \uBAA9\uC801\uC740 \uC774 \uC6CC\uB4DC \uC774\uD130\uB4E4\uC744
      \uC131\uCCB4\uAE4C\uC9C0 \uD0A4\uC6CC\uB0B4 \uC774 \uC2A4\uB9C8\uD2B8\uD3F0
      \uC548\uC5D0 \uB3D9\uAE30\uD654\uC2DC\uD0A4\uB294 \uAC83\uC785\uB2C8\uB2E4."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uC6CC\uB4DC \uC774\uD130\uB4E4\uC740 \uB2E8\uC5B4\uB97C \uBA39\uACE0
      \uC0B4\uC544\uC694."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uD558\uC9C0\uB9CC \uC544\uBB34 \uB2E8\uC5B4\uB098 \uBA39\uACE0 \uC0AC\uB294
      \uAC83\uC740 \uC544\uB2C8\uC8E0."
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uC8FC\uC5B4\uC9C4 \uD0A4\uBCF4\uB4DC\uB97C \uD1B5\uD574 \uC62C\uBC14\uB978
      \uB2E8\uC5B4\uB97C \uC870\uD569\uD574 \uBA39\uC5EC\uC57C \uBE44\uB85C\uC18C
      \uC131\uC7A5\uC744 \uD574\uC694."
    triggerMiniGame: 0
    effectType: 2
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 96775341}
  - text: "\uB610\uD55C, \uB2F9\uC2E0\uC774 \uB2E8\uC5B4\uB97C \uB9DE\uCD9C \uC218
      \uC788\uB3C4\uB85D \uB3C4\uC640\uC8FC\uB294 \uC5EC\uB7EC \uAC00\uC9C0 \uCD94\uAC00
      \uAE30\uB2A5\uB4E4\uC774 \uC874\uC7AC\uD574\uC694."
    triggerMiniGame: 0
    effectType: 2
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 1660095338}
  - text: "\uC804\uD654, \uBA54\uC138\uC9C0 \uB4F1\uC73C\uB85C \uB9DE\uCDB0\uC57C
      \uD558\uB294 \uB2E8\uC5B4\uC5D0 \uB300\uD55C \uD78C\uD2B8\uB97C \uBC1B\uC744
      \uC218 \uC788\uC5B4\uC694"
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uB610\uD55C \uBBF8\uB2C8\uAC8C\uC784\uC744 \uD1B5\uD574 \uB2E8\uC5B4\uC5D0
      \uB300\uD55C \uACB0\uC815\uC801\uC778 \uD78C\uD2B8\uC640 \uCD94\uAC00 \uAE00\uC790\uB97C
      \uC5BB\uC744 \uC218 \uC788\uC5B4\uC694"
    triggerMiniGame: 0
    effectType: 2
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 1435372435}
  - text: "\uB2E8, \uC704 \uBC30\uD130\uB9AC\uAC00 \uB2E4 \uB5A8\uC5B4\uC9C0\uBA74
      \uC6CC\uB4DC \uC774\uD130\uB294 \uC8FD\uC5B4\uBC84\uB9AC\uACE0, \uB2E4\uC2DC
      \uD0A4\uC6CC\uB0B4\uC57C \uD574\uC694."
    triggerMiniGame: 0
    effectType: 1
    effectImages:
    - {fileID: 2094085885}
    effectTargets:
    - {fileID: 2085855725}
    effectDuration: 1
    videoPlayer: {fileID: 0}
  - text: "\uAF2D \uBAA8\uB4E0 \uC6CC\uB4DC \uC774\uD130\uB4E4\uC744 \uD0A4\uC6CC\uB0B4
      \uC2A4\uB9C8\uD2B8\uD3F0\uC758 \uAE30\uB2A5\uC744 \uC644\uC131\uD574 \uC8FC\uC138\uC694!"
    triggerMiniGame: 0
    effectType: 0
    effectImages: []
    effectTargets: []
    effectDuration: 1
    videoPlayer: {fileID: 0}
  typingSpeed: 0.05
  standingImage: {fileID: 1374845893}
  fadeOutImage: {fileID: 565665779}
